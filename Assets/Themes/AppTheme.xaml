  <Style x:Key="Ico" TargetType="Path">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="StrokeThickness" Value="1.8"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    <Setter Property="SnapsToDevicePixels" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Botones -->
  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#e7ecf3"/>
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Tag" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#1a2230"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#36445a"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="#79b0ff"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="#1f6fe5"/>
    <Setter Property="BorderBrush" Value="#1f6fe5"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#3580f0"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#3580f0"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="#b2d1ff"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnSoft" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="#142540"/>
    <Setter Property="BorderBrush" Value="#1d3a66"/>
    <Setter Property="Foreground" Value="#79b0ff"/>
  </Style>
  <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="#a3aebf"/>
  </Style>
  <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="#331619"/>
    <Setter Property="BorderBrush" Value="#5a2328"/>
    <Setter Property="Foreground" Value="#ff8080"/>
  </Style>
  <Style x:Key="BtnSm" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>
  <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="#a3aebf"/>
  </Style>
  <Style x:Key="IconBtnSm" TargetType="Button" BasedOn="{StaticResource IconBtn}">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
  </Style>

  <!-- Chips -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Height" Value="22"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#2c384a"/>
    <Setter Property="Background" Value="#10161f"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="ChipAvatar" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="BorderBrush" Value="#1d3a66"/>
    <Setter Property="Background" Value="#142540"/>
  </Style>
  <Style x:Key="ChipWorld" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="BorderBrush" Value="#3a3166"/>

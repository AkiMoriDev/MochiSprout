<UserControl x:Class="MochiSprout.Views.PresetsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MochiSprout.Views" xmlns:models="clr-namespace:MochiSprout.Models" FontFamily="{StaticResource UiFont}">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#151c26"/>
      <Setter Property="BorderBrush" Value="#222b38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="18"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#2c384a"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EnvCard" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="#10161f" BorderBrush="#222b38" BorderThickness="1" CornerRadius="14" Padding="14,12">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#2c384a"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#79b0ff"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SegButton" TargetType="Button">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#a3aebf"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#79b0ff"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StatNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#e7ecf3"/>
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#8a96a8"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Tarjeta de preset -->
    <DataTemplate DataType="{x:Type models:ProjectProfile}">
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,14,0,0">
            <Button Style="{StaticResource Btn}" Margin="0,0,4,0" Command="{Binding DataContext.EditPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=Editar {0}}">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IcoEdit}" Style="{StaticResource Ico}" Margin="0,0,7,0"/>
                <TextBlock Text="Editar" Foreground="#e7ecf3" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnSoft}" Margin="4,0,0,0" Command="{Binding DataContext.RequestExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=Exportar {0} a VCC}">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IcoExport}" Style="{StaticResource Ico}" Margin="0,0,7,0"/>
                <TextBlock Text="Exportar a VCC" Foreground="#79b0ff" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </UniformGrid>
          <StackPanel>
            <DockPanel>
              <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,12,0" VerticalAlignment="Top">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#142540"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Mode}" Value="World">
                        <Setter Property="Background" Value="#221c3a"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Path Width="20" Height="20">
                  <Path.Style>
                    <Style TargetType="Path" BasedOn="{StaticResource Ico}">
                      <Setter Property="Data" Value="{StaticResource IcoAvatar}"/>
                      <Setter Property="Stroke" Value="#79b0ff"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="World">
                          <Setter Property="Data" Value="{StaticResource IcoWorld}"/>
                          <Setter Property="Stroke" Value="#b9a2ff"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
              </Border>
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                <TextBlock FontSize="13" Foreground="#8a96a8" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="38" Margin="0,2,0,0" ToolTip="{Binding Notes}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="{Binding Notes}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Notes}" Value="">
                          <Setter Property="Text" Value="Sin descripción"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                          <Setter Property="Text" Value="Sin descripción"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </DockPanel>
            <WrapPanel Margin="0,12,0,0">
              <Border>
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource ChipAvatar}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Mode}" Value="World">
                        <Setter Property="Background" Value="#221c3a"/>
                        <Setter Property="BorderBrush" Value="#3a3166"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mode}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                      <Setter Property="Foreground" Value="#79b0ff"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="World">
                          <Setter Property="Foreground" Value="#b9a2ff"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
              <Border Style="{StaticResource Chip}" ToolTip="{Binding UnityEditorPath}">
                <TextBlock Text="{Binding UnityDisplayLabel, StringFormat=Unity {0}}" Style="{StaticResource ChipText}" FontFamily="{StaticResource MonoFont}" FontWeight="Normal"/>
              </Border>
              <Border Style="{StaticResource ChipOk}" ToolTip="Hay una plantilla exportada de este preset en VCC.">
                <Border.Visibility>
                  <MultiBinding Converter="{StaticResource PresetInfo}" ConverterParameter="exported">
                    <Binding/>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="DataContext.PresetStamp" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                  </MultiBinding>
                </Border.Visibility>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="#5fd39a" Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <TextBlock Text="En VCC" Style="{StaticResource ChipText}" Foreground="#5fd39a"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource ChipWarn}">
                <Border.Visibility>
                  <MultiBinding Converter="{StaticResource PresetInfo}" ConverterParameter="missing">
                    <Binding/>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="DataContext.PresetStamp" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                  </MultiBinding>
                </Border.Visibility>
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IcoAlert}" Style="{StaticResource Ico}" Stroke="#f0b35a" Width="11" Height="11" Margin="0,0,5,0"/>
                  <TextBlock Style="{StaticResource ChipText}" Foreground="#f0b35a">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource PresetInfo}" ConverterParameter="missingText">
                        <Binding/>
                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        <Binding Path="DataContext.PresetStamp" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </Border>
            </WrapPanel>
            <Border BorderBrush="#222b38" BorderThickness="1" CornerRadius="12" Margin="0,6,0,0" ClipToBounds="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#10161f" CornerRadius="11,0,0,11" Padding="12,9">
                  <StackPanel>
                    <TextBlock Text="{Binding Packages.Count}" Style="{StaticResource StatNumber}"/>
                    <TextBlock Text="paquetes adicionales" Style="{StaticResource StatLabel}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#10161f" CornerRadius="0,11,11,0" BorderBrush="#222b38" BorderThickness="1,0,0,0" Padding="12,9">
                  <StackPanel>
                    <TextBlock Text="{Binding UnityPackages.Count}" Style="{StaticResource StatNumber}"/>
                    <TextBlock Text="archivos enlazados" Style="{StaticResource StatLabel}"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <TextBlock FontSize="12.5" Foreground="#a3aebf" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,12,0,0">
              <TextBlock.Text>
                <MultiBinding Converter="{StaticResource PresetInfo}" ConverterParameter="summary">
                  <Binding/>
                  <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                  <Binding Path="DataContext.PresetStamp" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                </MultiBinding>
              </TextBlock.Text>
              <TextBlock.ToolTip>
                <MultiBinding Converter="{StaticResource PresetInfo}" ConverterParameter="summary">
                  <Binding/>
                  <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                  <Binding Path="DataContext.PresetStamp" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                </MultiBinding>
              </TextBlock.ToolTip>
            </TextBlock>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- Tarjeta "Nuevo preset" -->
    <DataTemplate DataType="{x:Type views:NewPresetTile}">
      <Button Command="{Binding DataContext.NewPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" MinHeight="250" Cursor="Hand" AutomationProperties.Name="Nuevo preset">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Rectangle x:Name="Frame" Stroke="#2c384a" StrokeThickness="1.5" StrokeDashArray="4 3" RadiusX="16" RadiusY="16"/>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="Plus" Width="48" Height="48" CornerRadius="14" BorderBrush="#a3aebf" BorderThickness="1.5" HorizontalAlignment="Center">
                  <Path x:Name="PlusGlyph" Data="{StaticResource IcoPlus}" Style="{StaticResource Ico}" Stroke="#a3aebf" Width="20" Height="20"/>
                </Border>
                <TextBlock x:Name="Label" Text="Nuevo preset" FontSize="15" FontWeight="SemiBold" Foreground="#a3aebf" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Elegí tipo, Unity y paquetes" FontSize="13" Foreground="#8a96a8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Frame" Property="Stroke" Value="#1f6fe5"/>
                <Setter TargetName="Frame" Property="Fill" Value="#0D1F6FE5"/>
                <Setter TargetName="Plus" Property="BorderBrush" Value="#79b0ff"/>
                <Setter TargetName="PlusGlyph" Property="Stroke" Value="#79b0ff"/>
                <Setter TargetName="Label" Property="Foreground" Value="#79b0ff"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="Stroke" Value="#79b0ff"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>

    <!-- Tarjeta de plantilla oficial -->
    <DataTemplate x:Key="BaseCard">
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn}" Margin="0,14,0,0" Command="{Binding DataContext.UseTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=Usar {0} como base}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IcoPlus}" Style="{StaticResource Ico}" Margin="0,0,7,0"/>
              <TextBlock Text="Usar como base" Foreground="#e7ecf3" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel>
            <DockPanel>
              <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,12,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#142540"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAvatar}" Value="False">
                        <Setter Property="Background" Value="#221c3a"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Path Width="20" Height="20">
                  <Path.Style>
                    <Style TargetType="Path" BasedOn="{StaticResource Ico}">
                      <Setter Property="Data" Value="{StaticResource IcoAvatar}"/>
                      <Setter Property="Stroke" Value="#79b0ff"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAvatar}" Value="False">
                          <Setter Property="Data" Value="{StaticResource IcoWorld}"/>
                          <Setter Property="Stroke" Value="#b9a2ff"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                <TextBlock Text="{Binding FolderName}" FontSize="12" Foreground="#8a96a8" FontFamily="{StaticResource MonoFont}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}"/>
              </StackPanel>
            </DockPanel>
            <WrapPanel Margin="0,12,0,0">
              <Border>
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource ChipAvatar}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAvatar}" Value="False">
                        <Setter Property="Background" Value="#221c3a"/>
                        <Setter Property="BorderBrush" Value="#3a3166"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding KindLabel}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                      <Setter Property="Foreground" Value="#79b0ff"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAvatar}" Value="False">
                          <Setter Property="Foreground" Value="#b9a2ff"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
              <Border Style="{StaticResource Chip}">
                <TextBlock Text="{Binding UnityVersion, StringFormat=Unity {0}, TargetNullValue=Unity no declarado}" Style="{StaticResource ChipText}" FontFamily="{StaticResource MonoFont}" FontWeight="Normal"/>
              </Border>
            </WrapPanel>
            <Border BorderBrush="#222b38" BorderThickness="1" CornerRadius="12" Margin="0,6,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#10161f" CornerRadius="11,0,0,11" Padding="12,9">
                  <StackPanel>
                    <TextBlock Text="{Binding PackageCount}" Style="{StaticResource StatNumber}"/>
                    <TextBlock Text="paquetes incluidos" Style="{StaticResource StatLabel}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#10161f" CornerRadius="0,11,11,0" BorderBrush="#222b38" BorderThickness="1,0,0,0" Padding="12,9">
                  <StackPanel>
                    <TextBlock Text="{Binding FileCount}" Style="{StaticResource StatNumber}"/>
                    <TextBlock Text="archivos" Style="{StaticResource StatLabel}"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1240" Margin="32,28,32,48">
      <!-- Franja de entorno -->
      <views:AdaptiveCardPanel x:Name="EnvStrip" MinRowHeight="0">
        <Button Style="{StaticResource EnvCard}" Command="{Binding OpenSettingsCommand}" CommandParameter="vcc" AutomationProperties.Name="Estado de VCC: abrir configuración">
          <DockPanel>
            <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="#10291f"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding VccConnected}" Value="False">
                      <Setter Property="Background" Value="#2e2412"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Path Width="16" Height="16">
                <Path.Style>
                  <Style TargetType="Path" BasedOn="{StaticResource Ico}">
                    <Setter Property="Data" Value="{StaticResource IcoCheck}"/>
                    <Setter Property="Stroke" Value="#5fd39a"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding VccConnected}" Value="False">
                        <Setter Property="Data" Value="{StaticResource IcoAlert}"/>
                        <Setter Property="Stroke" Value="#f0b35a"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding VccEnvTitle}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding VccEnvDetail}" FontSize="12" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding VccEnvDetail}"/>
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Style="{StaticResource EnvCard}" Command="{Binding OpenSettingsCommand}" CommandParameter="unity" AutomationProperties.Name="Instalaciones de Unity: abrir configuración">
          <DockPanel>
            <Border Width="34" Height="34" CornerRadius="10" Background="#142540" Margin="0,0,12,0">
              <Path Data="{StaticResource IcoCube}" Style="{StaticResource Ico}" Stroke="#79b0ff"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding UnityEnvTitle}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding UnityEnvDetail}" FontSize="12" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding UnityEnvDetail}"/>
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Style="{StaticResource EnvCard}" Command="{Binding NavigateCommand}" CommandParameter="Paquetes de VCC" AutomationProperties.Name="Catálogo de paquetes: abrir">
          <DockPanel>
            <Border Width="34" Height="34" CornerRadius="10" Background="#13302b" Margin="0,0,12,0">
              <Path Data="{StaticResource IcoBox}" Style="{StaticResource Ico}" Stroke="#7fd6b8"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding CatalogEnvTitle}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="Caché local de VCC · actualizala desde VCC" FontSize="12" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </Button>
      </views:AdaptiveCardPanel>

      <!-- Mis presets -->
      <DockPanel Margin="0,36,0,16" LastChildFill="True">
        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
          <Border Background="#10161f" BorderBrush="#222b38" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,10,0" AutomationProperties.Name="Filtrar por tipo">
            <StackPanel Orientation="Horizontal">
              <Button Command="{Binding SetPresetTypeFilterCommand}" CommandParameter="Todos">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource SegButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PresetTypeFilter}" Value="Todos">
                        <Setter Property="Background" Value="#1a2230"/>
                        <Setter Property="BorderBrush" Value="#2c384a"/>
                        <Setter Property="Foreground" Value="#e7ecf3"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Todos" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <TextBlock Text="{Binding Presets.Count}" Foreground="#8a96a8" Margin="6,0,0,0"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding SetPresetTypeFilterCommand}" CommandParameter="Avatar">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource SegButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PresetTypeFilter}" Value="Avatar">
                        <Setter Property="Background" Value="#1a2230"/>
                        <Setter Property="BorderBrush" Value="#2c384a"/>
                        <Setter Property="Foreground" Value="#e7ecf3"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Avatar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <TextBlock Text="{Binding AvatarPresetCount}" Foreground="#8a96a8" Margin="6,0,0,0"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding SetPresetTypeFilterCommand}" CommandParameter="World">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource SegButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PresetTypeFilter}" Value="World">
                        <Setter Property="Background" Value="#1a2230"/>
                        <Setter Property="BorderBrush" Value="#2c384a"/>
                        <Setter Property="Foreground" Value="#e7ecf3"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="World" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <TextBlock Text="{Binding WorldPresetCount}" Foreground="#8a96a8" Margin="6,0,0,0"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding NewPresetCommand}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IcoPlus}" Style="{StaticResource Ico}" Margin="0,0,7,0"/>
              <TextBlock Text="Nuevo preset" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </WrapPanel>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="Mis presets" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Presets.Count, StringFormat=Los que creaste vos · {0} guardados}" FontSize="14" Foreground="#8a96a8" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
      <StackPanel Orientation="Horizontal" Margin="0,-4,0,14" Visibility="{Binding HasPresetQuery, Converter={StaticResource Bool}}">
        <TextBlock Text="{Binding PresetQueryLabel}" Foreground="#8a96a8" VerticalAlignment="Center"/>
        <TextBlock Text=" · " Foreground="#8a96a8" VerticalAlignment="Center"/>
        <Button Style="{StaticResource BtnGhost}" Height="24" Padding="4,0" Foreground="#79b0ff" Command="{Binding ClearPresetSearchCommand}">
          <TextBlock Text="Limpiar búsqueda" Foreground="#79b0ff" FontSize="13"/>
        </Button>
      </StackPanel>
      <Border BorderBrush="#2c384a" BorderThickness="1.5" CornerRadius="16" Padding="28" Margin="0,0,0,16" Visibility="{Binding NoPresetMatches, Converter={StaticResource Bool}}">
        <TextBlock Text="Ningún preset coincide con el filtro." Foreground="#8a96a8" HorizontalAlignment="Center"/>
      </Border>
      <ItemsControl x:Name="OwnCards" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <views:AdaptiveCardPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- Plantillas de VCC -->
      <DockPanel Margin="0,36,0,16">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Path Data="{StaticResource IcoLock}" Style="{StaticResource Ico}" Stroke="#8a96a8" Width="14" Height="14" Margin="0,0,6,0"/>
          <TextBlock Text="Solo lectura: usarlas no las modifica" Foreground="#8a96a8" FontSize="12.5" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="Plantillas de VCC" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding DefaultTemplates.Count, StringFormat=Bases oficiales detectadas en VRCTemplates · {0} encontradas}" FontSize="14" Foreground="#8a96a8" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
      <ItemsControl ItemsSource="{Binding DefaultTemplates}" ItemTemplate="{StaticResource BaseCard}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <views:AdaptiveCardPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <Border BorderBrush="#2c384a" BorderThickness="1.5" CornerRadius="16" Padding="28">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding DefaultTemplates.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="No se detectaron plantillas. Revisá la carpeta de VCC en Configuración." Foreground="#8a96a8" HorizontalAlignment="Center"/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

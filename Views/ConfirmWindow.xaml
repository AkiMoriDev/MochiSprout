<Window x:Class="MochiSprout.Views.ConfirmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Confirmar" Width="900" Height="700" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize" FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource Ink}" WindowStartupLocation="Manual">
  <Grid x:Name="OverlayRoot" Background="#B305080C">
    <Border x:Name="DialogPanel" Style="{StaticResource ModalPanel}" Width="440">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,12,12,12" MinHeight="60">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource WarnBg}" Margin="0,0,12,0">
              <Path Data="{StaticResource IcoAlert}" Style="{StaticResource Ico}" Stroke="{StaticResource WarnInk}"/>
            </Border>
            <TextBlock x:Name="TitleText" Style="{StaticResource ModalTitle}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource Surface2}" Padding="20,18">
          <TextBlock x:Name="MessageText" Foreground="#a3aebf" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="2" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,12,16,12" MinHeight="64">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="CancelButton" Style="{StaticResource Btn}" Click="Cancel" Margin="0,0,10,0" IsDefault="True"/>
            <Button x:Name="AcceptButton" Style="{StaticResource BtnDanger}" Click="Accept"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

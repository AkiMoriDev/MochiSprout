<Window x:Class="MochiSprout.Views.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MochiSprout.Views" Title="MochiSprout · Configuración inicial" Width="1000" Height="660" MinWidth="760" MinHeight="560" FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource Ink}" Background="#0d131b" WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Foreground" Value="#8a96a8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#1a2230"/>
                <Setter Property="Foreground" Value="#e7ecf3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseCaptionBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#c42b1c"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="WindowRoot">
    <Grid Background="#151c26">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{StaticResource Chrome}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource CaptionBtn}" Click="MinimizeWindow" AutomationProperties.Name="Minimizar" ToolTip="Minimizar">
              <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="1"/>
            </Button>
            <Button Style="{StaticResource CaptionBtn}" Click="ToggleMaximize" AutomationProperties.Name="Maximizar o restaurar" ToolTip="Maximizar">
              <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" RadiusX="1" RadiusY="1"/>
            </Button>
            <Button Style="{StaticResource CloseCaptionBtn}" Click="CloseWindow" AutomationProperties.Name="Cerrar" ToolTip="Cerrar sin guardar">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource SproutBg}">
              <Path Data="{StaticResource IcoSprout}" Style="{StaticResource Ico}" Stroke="{StaticResource SproutInk}" Width="17" Height="17"/>
            </Border>
            <TextBlock Text="MochiSprout" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Border Style="{StaticResource Chip}" Background="#13302b" BorderBrush="#1f4a40" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Configuración inicial" Style="{StaticResource ChipText}" Foreground="#7fd6b8"/>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
      <views:SetupView x:Name="Setup" Grid.Row="1">
        <views:SetupView.Style>
          <Style TargetType="views:SetupView">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="IsEnabled" Value="False"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </views:SetupView.Style>
      </views:SetupView>
    </Grid>
  </Border>
</Window>

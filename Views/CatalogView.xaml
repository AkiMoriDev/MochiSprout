<UserControl x:Class="MochiSprout.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#151c26" FontFamily="{StaticResource UiFont}">
  <UserControl.Resources>
    <Style x:Key="ColHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#8a96a8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="StableCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#a3aebf"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Surface" Background="#0f151e" BorderBrush="#2c384a" BorderThickness="1" CornerRadius="10" Padding="12,0" Height="36">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="Track" Width="30" Height="18" CornerRadius="9" Background="#2c384a" Margin="0,0,8,0">
                  <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#cfd8e4" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                </Border>
                <TextBlock Text="Solo estables" FontSize="13" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#1f6fe5"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                <Setter Property="Foreground" Value="#e7ecf3"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#3e4d66"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#79b0ff"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Encabezado -->
    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,12,12,12" MinHeight="60">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Click="CloseCatalog" AutomationProperties.Name="Cerrar paquetes" ToolTip="Cerrar paquetes">
          <Path Data="{StaticResource IcoX}" Style="{StaticResource Ico}" Width="14" Height="14"/>
        </Button>
        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource SproutBg}" Margin="0,0,12,0" VerticalAlignment="Center">
          <Path Data="{StaticResource IcoBox}" Style="{StaticResource Ico}" Stroke="{StaticResource SproutInk}"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Paquetes de VCC" Style="{StaticResource ModalTitle}"/>
          <TextBlock Style="{StaticResource ModalSubtitle}" Text="{Binding CatalogEnvTitle, StringFormat={}{0} registrados · caché local}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Búsqueda y filtros -->
    <Border Grid.Row="1" Padding="20,14,20,12" Background="{StaticResource Surface}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto" MaxWidth="240"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox Text="{Binding BrowseSearch, UpdateSourceTrigger=PropertyChanged, Delay=180}" Tag="Buscar por nombre o ID" Padding="34,0,10,0" MinHeight="0" Height="36" VerticalContentAlignment="Center" CaretBrush="White" AutomationProperties.Name="Buscar paquetes">
            <TextBox.Template>
              <ControlTemplate TargetType="TextBox">
                <Border x:Name="Box" CornerRadius="10" Background="#0f151e" BorderBrush="#2c384a" BorderThickness="1">
                  <Grid>
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#8a96a8" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="Text" Value="">
                    <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                  </Trigger>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="#1f6fe5"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </TextBox.Template>
          </TextBox>
          <Path Data="{StaticResource IcoSearch}" Style="{StaticResource Ico}" Stroke="#8a96a8" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" Width="15" Height="15"/>
        </Grid>
        <ComboBox Grid.Column="2" MinWidth="210" Height="36" MinHeight="36" ItemsSource="{Binding Repositories}" SelectedItem="{Binding BrowseRepository}" AutomationProperties.Name="Filtrar por repositorio" ToolTip="{Binding BrowseRepository}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="13"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Grid.Column="4" Style="{StaticResource StableCheck}" IsChecked="{Binding OnlyStable}" AutomationProperties.Name="Solo versiones estables"/>
      </Grid>
    </Border>

    <!-- Tabla -->
    <DockPanel Grid.Row="2" Background="{StaticResource Surface2}">
      <Border DockPanel.Dock="Top" Background="{StaticResource Raise}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,1" Height="34" Padding="20,0,30,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*" MaxWidth="240"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="196"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="PAQUETE" Style="{StaticResource ColHead}"/>
          <TextBlock Grid.Column="1" Text="REPOSITORIO" Style="{StaticResource ColHead}"/>
          <TextBlock Grid.Column="2" Text="VERSIÓN" Style="{StaticResource ColHead}"/>
        </Grid>
      </Border>
      <Grid>
        <ListBox x:Name="CatalogTable" ItemsSource="{Binding CatalogBrowseView}" Background="Transparent" AutomationProperties.Name="Catálogo de paquetes" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="#151c26"/>
                      </Trigger>
                      <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="#142540"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#222b38" BorderThickness="0,0,0,1" Padding="20,0,12,0" MinHeight="58" MouseLeftButtonUp="PackageRowClick" Cursor="Hand" Background="Transparent">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*" MaxWidth="240"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="196"/>
                  </Grid.ColumnDefinitions>
                  <DockPanel Margin="0,0,14,0">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#142540" Margin="0,0,12,0" VerticalAlignment="Center">
                      <Path Data="{StaticResource IcoBox}" Style="{StaticResource Ico}" Stroke="#79b0ff" Width="15" Height="15"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                      <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Id}"/>
                    </StackPanel>
                  </DockPanel>
                  <TextBlock Grid.Column="1" Text="{Binding RepositoryName}" FontSize="13" Foreground="#a3aebf" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="{Binding RepositoryName}"/>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="#e7ecf3">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="{Binding LatestVersion}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.OnlyStable, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                              <Setter Property="Text" Value="{Binding LatestStableVersion}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding VersionCount}" FontSize="11.5" Foreground="#8a96a8" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Height="28" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="El SDK se incluye desde la plantilla base Avatar/World." Visibility="{Binding IsSdk, Converter={StaticResource Bool}}">
                      <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ChipOk}">
                          <Setter Property="Margin" Value="0,0,8,0"/>
                          <Setter Property="CornerRadius" Value="8"/>
                          <Setter Property="Padding" Value="10,0"/>
                        </Style>
                      </Border.Style>
                      <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IcoLock}" Style="{StaticResource Ico}" Stroke="#5fd39a" Width="11" Height="11" Margin="0,0,6,0"/>
                        <TextBlock Text="En la base" Style="{StaticResource ChipText}" Foreground="#5fd39a"/>
                      </StackPanel>
                    </Border>
                    <Button Content="Usar en preset" Style="{StaticResource BtnSoft}" Height="30" Padding="12,0" FontSize="12.5" Margin="0,0,8,0" Click="UsePackage" IsEnabled="{Binding CanSelect}" Visibility="{Binding CanSelect, Converter={StaticResource Bool}}" AutomationProperties.Name="{Binding DisplayName, StringFormat=Usar {0} en un preset}"/>
                    <Button Content="Info" Style="{StaticResource Btn}" Height="30" Padding="10,0" FontSize="12.5" Click="ShowPackageInfo" AutomationProperties.Name="Información del paquete" ToolTip="Ver versiones, dependencias y autor"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Items.Count, ElementName=CatalogTable}" Value="0">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Path Data="{StaticResource IcoSearch}" Style="{StaticResource Ico}" Stroke="#8a96a8" Width="22" Height="22" HorizontalAlignment="Center"/>
          <TextBlock Text="Ningún paquete coincide con la búsqueda." Foreground="#a3aebf" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          <TextBlock Text="Probá con otro nombre, otro repositorio o desactivá «Solo estables»." Foreground="#8a96a8" FontSize="12.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </DockPanel>

    <!-- Nota inferior -->
    <Border Grid.Row="3" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Background="{StaticResource Surface}" Padding="20,10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding FilteredCatalogCount}" Foreground="#8a96a8" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <Path Data="{StaticResource IcoInfo}" Style="{StaticResource Ico}" Stroke="#8a96a8" Width="14" Height="14" Margin="0,0,8,0"/>
        <TextBlock Text="El catálogo se lee de la caché local. Para ver versiones nuevas, actualizá los repositorios desde VCC." Foreground="#8a96a8" FontSize="12.5" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>

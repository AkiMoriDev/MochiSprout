<UserControl x:Class="MochiSprout.Views.EditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:MochiSprout.Models" xmlns:views="clr-namespace:MochiSprout.Views" FontFamily="Inter, Segoe UI" Foreground="#e7ecf3" Background="#151c26">
  <UserControl.Resources>
    <views:EditorSelectionConverter x:Key="Matches"/>
    <Style x:Key="EditorLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="#c6cfdb"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="EditorCard" TargetType="Border">
      <Setter Property="Background" Value="#151c26"/>
      <Setter Property="BorderBrush" Value="#222b38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="#0f151e"/>
      <Setter Property="BorderBrush" Value="#2c384a"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Box" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#8a96a8" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#79b0ff"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Background" Value="#0f151e"/>
      <Setter Property="BorderBrush" Value="#2c384a"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="#2c384a" BorderThickness="1" CornerRadius="10">
                      <TextBlock Text="⌄" Foreground="#9EB5D0" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter ClipToBounds="True" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="11,7,30,7" VerticalAlignment="Center"/>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{StaticResource Panel}" BorderBrush="#2c384a" BorderThickness="1" CornerRadius="10" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300">
                  <ScrollViewer>
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="#509EFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EditorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#2c384a"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#79b0ff"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TypeOption" TargetType="RadioButton">
      <Setter Property="Height" Value="52"/>
      <Setter Property="Foreground" Value="#a3aebf"/>
      <Setter Property="Background" Value="#0f151e"/>
      <Setter Property="BorderBrush" Value="#2c384a"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Choice" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#142540"/>
                <Setter Property="Foreground" Value="#e7ecf3"/>
                <Setter Property="BorderBrush" Value="#79b0ff"/>
                <Setter TargetName="Choice" Property="BorderThickness" Value="1.5"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Choice" Property="BorderBrush" Value="#b2d1ff"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="VariantOption" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="Choice" CornerRadius="12" Background="#0f151e" BorderBrush="#2c384a" BorderThickness="1" Padding="10">
                <ContentPresenter/>
              </Border>
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#79b0ff" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Choice" Property="BorderBrush" Value="#3e4d66"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Choice" Property="Background" Value="#0f1d33"/>
                <Setter TargetName="Choice" Property="BorderBrush" Value="#1f6fe5"/>
                <Setter TargetName="Choice" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Choice" Property="Padding" Value="9"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Choice" Property="BorderBrush" Value="#b2d1ff"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource TypeOption}">
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="SegmentSurface" Background="Transparent" CornerRadius="7" Padding="10,5">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SegmentSurface" Property="Background" Value="#263142"/>
                <Setter Property="Foreground" Value="#e7ecf3"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="SegmentSurface" Property="BorderBrush" Value="#79b0ff"/>
                <Setter TargetName="SegmentSurface" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Width" Value="112"/>
      <Setter Property="Foreground" Value="#a3aebf"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,20,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabLine" Padding="0,0,0,2" BorderThickness="0,0,0,2" BorderBrush="Transparent" Height="52">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#e7ecf3"/>
                <Setter TargetName="TabLine" Property="BorderBrush" Value="#79b0ff"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabLine" Property="BorderBrush" Value="#b2d1ff"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TabBadge" TargetType="Border">
      <Setter Property="Background" Value="#222b38"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="Margin" Value="7,0,0,0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
          <Setter Property="Background" Value="#1b3256"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TabCount" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#a3aebf"/>
      <Setter Property="FontSize" Value="12"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
          <Setter Property="Foreground" Value="#79b0ff"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PackageCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Check" Width="18" Height="18" CornerRadius="4" Background="#0f151e" BorderBrush="#66768b" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M1,5 L4,8 L10,1" Stroke="White" StrokeThickness="1.8" Width="11" Height="9" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
              <Grid.Style>
                <Style TargetType="Grid">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter Property="Background" Value="#142540"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Background" Value="#1f6fe5"/>
                <Setter TargetName="Check" Property="BorderBrush" Value="#1f6fe5"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Check" Property="BorderBrush" Value="#b2d1ff"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border BorderBrush="#263142" BorderThickness="0,0,0,1" Padding="22,9,22,9">
      <Grid>
        <StackPanel VerticalAlignment="Center" Margin="0,0,54,0">
          <TextBlock Text="{Binding EditorModalTitle}" FontSize="16.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding EditorModalTitle}"/>
          <TextBlock Text="{Binding EditorSubtitle}" FontSize="12.5" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Style="{StaticResource EditorButton}" Width="36" Height="36" Padding="0" Background="#1a2230" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseEditor" AutomationProperties.Name="Cerrar" ToolTip="Cerrar">
          <Grid Width="16" Height="16">
            <Path Data="M2,2 L14,14 M14,2 L2,14" Stroke="#c6cfdb" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Grid>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#0f141c" Padding="22,18">
      <Grid x:Name="EditorBody">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="InformationColumn" Width="320"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource EditorCard}">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="#222b38" BorderThickness="0,0,0,1" Padding="18,14">
              <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="9" Background="#15243b" Margin="0,0,10,0">
                  <Path Data="M0,1 L16,1 M0,7 L16,7 M0,13 L10,13" Stroke="#79b0ff" StrokeThickness="1.8" Width="18" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Información" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="18,16">
                <TextBlock Text="Nombre" Style="{StaticResource EditorLabel}"/>
                <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Ej.: Mi avatar base" Height="40" AutomationProperties.Name="Nombre"/>
                <TextBlock Text="Descripción" Style="{StaticResource EditorLabel}" Margin="0,12,0,7"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Tag="Opcional" Height="82" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Descripción"/>
                <TextBlock Text="Tipo y versión de Unity" Style="{StaticResource EditorLabel}" Margin="0,14,0,7"/>
                <Grid AutomationProperties.Name="Tipo y versión de Unity">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <RadioButton Grid.Row="0" Grid.Column="0" GroupName="ProjectVariant" Style="{StaticResource VariantOption}" Command="{Binding SelectProjectVariantCommand}" CommandParameter="Avatar-2022" IsChecked="{Binding SelectedProjectVariant, Mode=OneWay, Converter={StaticResource Matches}, ConverterParameter=Avatar-2022}" AutomationProperties.Name="Avatar Unity 2022" ToolTip="Avatar con Unity 2022. Requiere una instalación de Unity 2022 accesible; si falta, agregala en Configuración." ToolTipService.ShowOnDisabled="True">
                    <DockPanel>
                      <Border Width="26" Height="26" CornerRadius="8" Background="#142540" Margin="0,0,8,0">
                        <Path Data="{StaticResource IcoAvatar}" Style="{StaticResource Ico}" Stroke="#79b0ff" Width="15" Height="15"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Avatar" FontSize="13" FontWeight="SemiBold" Foreground="#e7ecf3"/>
                        <TextBlock Text="{Binding Unity2022Choice}" FontSize="11.5" ToolTip="{Binding Unity2022Choice}" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DockPanel>
                  </RadioButton>
                  <RadioButton Grid.Row="0" Grid.Column="2" GroupName="ProjectVariant" Style="{StaticResource VariantOption}" Command="{Binding SelectProjectVariantCommand}" CommandParameter="World-2022" IsChecked="{Binding SelectedProjectVariant, Mode=OneWay, Converter={StaticResource Matches}, ConverterParameter=World-2022}" AutomationProperties.Name="World Unity 2022" ToolTip="World con Unity 2022. Requiere una instalación de Unity 2022 accesible; si falta, agregala en Configuración." ToolTipService.ShowOnDisabled="True">
                    <DockPanel>
                      <Border Width="26" Height="26" CornerRadius="8" Background="#221c3a" Margin="0,0,8,0">
                        <Path Data="{StaticResource IcoWorld}" Style="{StaticResource Ico}" Stroke="#b9a2ff" Width="15" Height="15"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="World" FontSize="13" FontWeight="SemiBold" Foreground="#e7ecf3"/>
                        <TextBlock Text="{Binding Unity2022Choice}" FontSize="11.5" ToolTip="{Binding Unity2022Choice}" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DockPanel>
                  </RadioButton>
                  <RadioButton Grid.Row="2" Grid.Column="0" GroupName="ProjectVariant" Style="{StaticResource VariantOption}" Command="{Binding SelectProjectVariantCommand}" CommandParameter="Avatar-2019" IsChecked="{Binding SelectedProjectVariant, Mode=OneWay, Converter={StaticResource Matches}, ConverterParameter=Avatar-2019}" AutomationProperties.Name="Avatar Unity 2019" ToolTip="Avatar con Unity 2019. Requiere una instalación de Unity 2019 accesible; si falta, agregala en Configuración." ToolTipService.ShowOnDisabled="True">
                    <DockPanel>
                      <Border Width="26" Height="26" CornerRadius="8" Background="#142540" Margin="0,0,8,0">
                        <Path Data="{StaticResource IcoAvatar}" Style="{StaticResource Ico}" Stroke="#79b0ff" Width="15" Height="15"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Avatar" FontSize="13" FontWeight="SemiBold" Foreground="#e7ecf3"/>
                        <TextBlock Text="{Binding Unity2019Choice}" FontSize="11.5" ToolTip="{Binding Unity2019Choice}" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DockPanel>
                  </RadioButton>
                  <RadioButton Grid.Row="2" Grid.Column="2" GroupName="ProjectVariant" Style="{StaticResource VariantOption}" Command="{Binding SelectProjectVariantCommand}" CommandParameter="World-2019" IsChecked="{Binding SelectedProjectVariant, Mode=OneWay, Converter={StaticResource Matches}, ConverterParameter=World-2019}" AutomationProperties.Name="World Unity 2019" ToolTip="World con Unity 2019. Requiere una instalación de Unity 2019 accesible; si falta, agregala en Configuración." ToolTipService.ShowOnDisabled="True">
                    <DockPanel>
                      <Border Width="26" Height="26" CornerRadius="8" Background="#221c3a" Margin="0,0,8,0">
                        <Path Data="{StaticResource IcoWorld}" Style="{StaticResource Ico}" Stroke="#b9a2ff" Width="15" Height="15"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="World" FontSize="13" FontWeight="SemiBold" Foreground="#e7ecf3"/>
                        <TextBlock Text="{Binding Unity2019Choice}" FontSize="11.5" ToolTip="{Binding Unity2019Choice}" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DockPanel>
                  </RadioButton>
                </Grid>
                <Border Background="#10161f" BorderBrush="#222b38" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,12,0,0">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="Instalación de Unity" Foreground="#8a96a8" FontSize="12.5" Margin="0,0,10,0"/>
                      <TextBlock Text="{Binding SelectedUnity.Version, TargetNullValue=Sin instalación}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedUnity.EditorPath}" AutomationProperties.Name="Instalación de Unity seleccionada"/>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                      <TextBlock Text="Plantilla base" Foreground="#8a96a8" FontSize="12.5" Margin="0,0,10,0"/>
                      <TextBlock Text="{Binding EditorBaseLabel}" FontSize="12.5" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding EditorBaseLabel}"/>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <TextBlock Text="Validación" Style="{StaticResource EditorLabel}" Margin="0,16,0,7"/>
                <ItemsControl ItemsSource="{Binding EditorIssues}" Focusable="False" AutomationProperties.Name="Validación del preset" AutomationProperties.LiveSetting="Polite">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="Item" Background="#10161f" BorderBrush="#222b38" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                        <DockPanel>
                          <Path x:Name="Glyph" Data="{StaticResource IcoCheck}" Style="{StaticResource Ico}" Stroke="#5fd39a" Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,8,0"/>
                          <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}" Height="24" Padding="8,0" Margin="8,0,0,0" VerticalAlignment="Top" Visibility="{Binding HasFix, Converter={StaticResource Bool}}" Command="{Binding DataContext.AddDependencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding FixPackageId}" AutomationProperties.Name="Agregar dependencia">
                            <TextBlock Text="{Binding FixLabel}" Foreground="#e7ecf3" FontSize="12"/>
                          </Button>
                          <TextBlock x:Name="Text" Text="{Binding Text}" FontSize="12.5" Foreground="#5fd39a" TextWrapping="Wrap"/>
                        </DockPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="warn">
                          <Setter TargetName="Item" Property="Background" Value="#2e2412"/>
                          <Setter TargetName="Item" Property="BorderBrush" Value="#4f3b18"/>
                          <Setter TargetName="Glyph" Property="Data" Value="{StaticResource IcoAlert}"/>
                          <Setter TargetName="Glyph" Property="Stroke" Value="#f0b35a"/>
                          <Setter TargetName="Text" Property="Foreground" Value="#f3d29c"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="err">
                          <Setter TargetName="Item" Property="Background" Value="#331619"/>
                          <Setter TargetName="Item" Property="BorderBrush" Value="#5a2328"/>
                          <Setter TargetName="Glyph" Property="Data" Value="{StaticResource IcoX}"/>
                          <Setter TargetName="Glyph" Property="Stroke" Value="#ff8080"/>
                          <Setter TargetName="Text" Property="Foreground" Value="#ffc2c2"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource EditorCard}">
          <Grid>
            <TabControl x:Name="EditorTabs" BorderThickness="0" Background="Transparent">
              <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="52"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="#222b38" BorderThickness="0,0,0,1" Padding="18,0">
                      <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
                    </Border>
                    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                  </Grid>
                </ControlTemplate>
              </TabControl.Template>
              <TabItem AutomationProperties.Name="Paquetes">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Paquetes"/>
                    <Border Style="{StaticResource TabBadge}">
                      <TextBlock Text="{Binding DataContext.EditorPackageCount, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource TabCount}"/>
                    </Border>
                  </StackPanel>
                </TabItem.Header>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid x:Name="PackageToolbar" Margin="18,12">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="40"/>
                      <RowDefinition Height="10"/>
                      <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="3">
                      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=180}" Tag="Buscar paquetes…" Padding="30,8,8,8" AutomationProperties.Name="Buscar paquetes"/>
                      <Path Data="M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 M12,12 L18,18" Stroke="#a3aebf" StrokeThickness="1.8" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <Border Grid.Row="2" Background="#0f151e" BorderBrush="#2c384a" BorderThickness="1" CornerRadius="9" Padding="2">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Todos" GroupName="PackageFilter" Style="{StaticResource Segment}" IsChecked="{Binding OnlySelectedPackages, Mode=OneWay, Converter={StaticResource Matches}, ConverterParameter=False}" Click="ShowAll"/>
                        <RadioButton Content="{Binding SelectedFilterLabel}" GroupName="PackageFilter" Style="{StaticResource Segment}" IsChecked="{Binding OnlySelectedPackages, Mode=OneWay, Converter={StaticResource Matches}, ConverterParameter=True}" Click="ShowSelected"/>
                      </StackPanel>
                    </Border>
                    <ComboBox x:Name="RepositorySelect" Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Repositories}" SelectedItem="{Binding Repository}" ToolTip="{Binding Repository}" AutomationProperties.Name="Repositorio">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontWeight="Normal"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                  <Border Grid.Row="1" Background="#1a2230" Padding="0,0,18,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="44"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="1" Text="Paquete" Style="{StaticResource EditorLabel}" VerticalAlignment="Center" Margin="0"/>
                      <TextBlock Grid.Column="2" Text="Repositorio" Style="{StaticResource EditorLabel}" VerticalAlignment="Center" Margin="0"/>
                      <TextBlock Grid.Column="3" Text="Versión" Style="{StaticResource EditorLabel}" VerticalAlignment="Center" Margin="0"/>
                    </Grid>
                  </Border>
                  <ListBox x:Name="PackageList" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding PackageView}" AutomationProperties.Name="Paquetes para el preset">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#1f2836" BorderThickness="0,0,0,1" Height="50">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="Transparent"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="Background" Value="#142540"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="110"/>
                              <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" Style="{StaticResource PackageCheck}" AutomationProperties.Name="{Binding DisplayName}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="3*"/>
                                  <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Medium" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding RepositoryName}" FontSize="13" Foreground="#a3aebf" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RepositoryName}" Margin="0,0,10,0"/>
                              </Grid>
                            </CheckBox>
                            <ComboBox Grid.Column="1" Height="32" MinHeight="32" ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Version" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="Versión del paquete"/>
                            <Button Grid.Column="2" Style="{StaticResource IconBtnSm}" HorizontalAlignment="Right" Click="ShowPackageInfo" AutomationProperties.Name="{Binding DisplayName, StringFormat=Información de {0}}" ToolTip="Información del paquete">
                              <Path Data="{StaticResource IcoInfo}" Style="{StaticResource Ico}" Width="15" Height="15"/>
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Border Grid.Row="3" BorderBrush="#222b38" BorderThickness="0,1,0,0" Padding="18,12">
                    <TextBlock Text="El SDK se incluye desde la plantilla base Avatar/World." FontSize="12" Foreground="#a3aebf"/>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem AutomationProperties.Name="Archivos">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Archivos"/>
                    <Border Style="{StaticResource TabBadge}">
                      <TextBlock Text="{Binding DataContext.EditorFileCount, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource TabCount}"/>
                    </Border>
                  </StackPanel>
                </TabItem.Header>
                <DockPanel x:Name="FilesPanel" AllowDrop="True" Background="Transparent" DragEnter="FilesDragOver" DragOver="FilesDragOver" DragLeave="FilesDragLeave" Drop="FilesDrop">
                  <Border DockPanel.Dock="Bottom" BorderBrush="#222b38" BorderThickness="0,1,0,0" Padding="18,12">
                    <TextBlock Text="Se enlazan por su ruta original, sin copiarlos. Quitar una referencia no borra el archivo." FontSize="12" Foreground="#a3aebf"/>
                  </Border>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                      <Button x:Name="DropZone" Click="AddPackages" Cursor="Hand" Margin="0,0,0,12" AutomationProperties.Name="Agregar archivos .unitypackage">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                              <Rectangle x:Name="Frame" RadiusX="14" RadiusY="14" Stroke="#2c384a" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                              <StackPanel HorizontalAlignment="Center" Margin="20,22">
                                <Path x:Name="Glyph" Data="{StaticResource IcoUpload}" Style="{StaticResource Ico}" Stroke="#8a96a8" Width="22" Height="22" HorizontalAlignment="Center"/>
                                <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="13" Foreground="#8a96a8" TextAlignment="Center" TextWrapping="Wrap"><Run Text="Arrastrá archivos .unitypackage acá" Foreground="#e7ecf3" FontWeight="SemiBold"/><Run Text=" o hacé clic para elegirlos"/></TextBlock>
                              </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Stroke" Value="#1f6fe5"/>
                                <Setter TargetName="Frame" Property="Fill" Value="#0D1F6FE5"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="#79b0ff"/>
                              </Trigger>
                              <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="Stroke" Value="#79b0ff"/>
                              </Trigger>
                              <Trigger Property="Tag" Value="over">
                                <Setter TargetName="Frame" Property="Stroke" Value="#1f6fe5"/>
                                <Setter TargetName="Frame" Property="Fill" Value="#141F6FE5"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="#79b0ff"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                      <ItemsControl ItemsSource="{Binding Attachments}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#151c26" BorderBrush="#222b38" BorderThickness="1" CornerRadius="12" Padding="12,10,10,10" Margin="0,0,0,8">
                              <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtnSm}" AutomationProperties.Name="Quitar archivo" ToolTip="Quitar archivo" Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                  <Path Data="{StaticResource IcoX}" Style="{StaticResource Ico}" Width="12" Height="12"/>
                                </Button>
                                <Border x:Name="FileIcon" Width="34" Height="34" CornerRadius="10" Background="#2a2112" Margin="0,0,12,0">
                                  <Path x:Name="FileGlyph" Data="{StaticResource IcoFile}" Style="{StaticResource Ico}" Stroke="#f0b35a"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                  <TextBlock x:Name="FilePath" Text="{Binding FullPath}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                </StackPanel>
                              </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding Exists}" Value="False">
                                <Setter TargetName="FileIcon" Property="Background" Value="#331619"/>
                                <Setter TargetName="FileGlyph" Property="Stroke" Value="#ff8080"/>
                                <Setter TargetName="FilePath" Property="Foreground" Value="#ff8080"/>
                                <Setter TargetName="FilePath" Property="Text" Value="No se encuentra el archivo en su ruta original"/>
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Todavía no agregaste archivos .unitypackage" Foreground="#8a96a8" HorizontalAlignment="Center" FontSize="13" Margin="0,6,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Attachments.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </TabItem>
            </TabControl>
            <Button Content="+ Agregar .unitypackage" Click="AddPackages" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,9,18,0" Padding="10,0" FontSize="12">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource EditorButton}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=EditorTabs}" Value="1">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Border Grid.Row="2" BorderBrush="#263142" BorderThickness="0,1,0,0" Padding="22,14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding EditorFooterSummary}" FontSize="13" Foreground="#a3aebf" VerticalAlignment="Center"/>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Content="Cancelar" Style="{StaticResource Btn}" Click="CloseEditor" Margin="0,0,10,0"/>
          <Button Content="{Binding EditorSaveLabel}" Style="{StaticResource BtnPrimary}" Click="SaveDraft"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Binding EditorMessage}" Foreground="#f0c46a" FontSize="12" AutomationProperties.LiveSetting="Assertive"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,8,0,0"/><Style.Triggers><DataTrigger Binding="{Binding EditorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
    </Border>
  </Grid>
</UserControl>

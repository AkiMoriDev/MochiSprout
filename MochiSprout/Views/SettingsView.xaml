<UserControl x:Class="MochiSprout.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource UiFont}">
  <UserControl.Resources>
    <Style x:Key="NavItem" TargetType="Button">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#a3aebf"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#1a2230"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#79b0ff"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="34" Height="20" CornerRadius="10" Background="#2c384a" BorderBrush="Transparent" BorderThickness="1">
              <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#cfd8e4" HorizontalAlignment="Left" Margin="2,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#1f6fe5"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="#79b0ff"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#e7ecf3"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="RowHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#8a96a8"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="SectionHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#e7ecf3"/>
    </Style>
    <Style x:Key="Lead" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8a96a8"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,18"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,12,12,12" MinHeight="60">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Click="CloseSettings" AutomationProperties.Name="Cerrar" ToolTip="Cerrar" IsEnabled="{Binding IsBusy, Converter={StaticResource MatchBool}, ConverterParameter=False}">
          <Path Data="{StaticResource IcoX}" Style="{StaticResource Ico}" Width="14" Height="14"/>
        </Button>
        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Raise}" Margin="0,0,12,0" VerticalAlignment="Center">
          <Path Data="{StaticResource IcoGear}" Style="{StaticResource Ico}" Stroke="#a3aebf"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Configuración" Style="{StaticResource ModalTitle}"/>
          <TextBlock Text="Herramientas que usa MochiSprout y preferencias de la aplicación." Style="{StaticResource ModalSubtitle}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavColumn" Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="NavHost" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0" Background="{StaticResource Surface}" Padding="10,14">
        <StackPanel x:Name="NavItems" AutomationProperties.Name="Secciones de configuración">
          <Button Command="{Binding SetSettingsSectionCommand}" CommandParameter="vcc" AutomationProperties.Name="VRChat Creator Companion">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SettingsSection}" Value="vcc">
                    <Setter Property="Background" Value="#142540"/>
                    <Setter Property="Foreground" Value="#79b0ff"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IcoLink}" Style="{StaticResource Ico}" Margin="0,0,10,0"/>
              <TextBlock Text="VCC" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding SetSettingsSectionCommand}" CommandParameter="unity" AutomationProperties.Name="Instalaciones de Unity">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SettingsSection}" Value="unity">
                    <Setter Property="Background" Value="#142540"/>
                    <Setter Property="Foreground" Value="#79b0ff"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IcoCube}" Style="{StaticResource Ico}" Margin="0,0,10,0"/>
              <TextBlock Text="Unity" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding SetSettingsSectionCommand}" CommandParameter="data" AutomationProperties.Name="Presets y respaldos">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SettingsSection}" Value="data">
                    <Setter Property="Background" Value="#142540"/>
                    <Setter Property="Foreground" Value="#79b0ff"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IcoDb}" Style="{StaticResource Ico}" Margin="0,0,10,0"/>
              <TextBlock Text="Presets y respaldos" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding SetSettingsSectionCommand}" CommandParameter="prefs" AutomationProperties.Name="Preferencias">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SettingsSection}" Value="prefs">
                    <Setter Property="Background" Value="#142540"/>
                    <Setter Property="Foreground" Value="#79b0ff"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IcoSliders}" Style="{StaticResource Ico}" Margin="0,0,10,0"/>
              <TextBlock Text="Preferencias" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource Surface2}">
        <Grid Margin="24,22">
          <!-- VCC -->
          <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource MatchVis}, ConverterParameter=vcc}">
            <TextBlock Text="VRChat Creator Companion" Style="{StaticResource SectionHead}"/>
            <TextBlock Text="MochiSprout lee la configuración, los repositorios registrados y las plantillas de VCC desde esta carpeta." Style="{StaticResource Lead}"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <DockPanel Margin="16,14">
                  <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#10291f"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding VccConnected}" Value="False">
                            <Setter Property="Background" Value="#2e2412"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Path Width="16" Height="16">
                      <Path.Style>
                        <Style TargetType="Path" BasedOn="{StaticResource Ico}">
                          <Setter Property="Data" Value="{StaticResource IcoCheck}"/>
                          <Setter Property="Stroke" Value="#5fd39a"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding VccConnected}" Value="False">
                              <Setter Property="Data" Value="{StaticResource IcoAlert}"/>
                              <Setter Property="Stroke" Value="#f0b35a"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding VccEnvTitle}" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Se comprueba que exista settings.json en la carpeta; no es una conexión de red." Style="{StaticResource RowHint}"/>
                  </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource GroupRow}">
                  <StackPanel>
                    <TextBlock Text="Carpeta de datos de VCC" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="ChooseVcc" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource IcoFolder}" Style="{StaticResource Ico}" Margin="0,0,7,0"/>
                          <TextBlock Text="Cambiar carpeta" Foreground="#e7ecf3" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <TextBox Text="{Binding VccPathDraft, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" MinHeight="34" Padding="10,6" AutomationProperties.Name="Carpeta de datos de VCC"/>
                    </DockPanel>
                    <TextBlock Text="Los cambios de carpeta se aplican al guardar la configuración." Style="{StaticResource RowHint}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource GroupRow}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Command="{Binding RefreshSourcesCommand}" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Volver a detectar" Foreground="#e7ecf3"/>
                    </Button>
                    <StackPanel>
                      <TextBlock Text="{Binding CatalogEnvTitle}" Style="{StaticResource RowTitle}"/>
                      <TextBlock Text="{Binding CatalogStatus}" Style="{StaticResource RowHint}"/>
                      <TextBlock Text="El catálogo se lee de la caché local. Para ver versiones nuevas, actualizá los repositorios desde VCC." Style="{StaticResource RowHint}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Unity -->
          <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource MatchVis}, ConverterParameter=unity}">
            <TextBlock Text="Instalaciones de Unity" Style="{StaticResource SectionHead}"/>
            <TextBlock Text="Detectadas en Unity Hub y agregadas a mano. En cada preset elegís cuál usar." Style="{StaticResource Lead}"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Installs}" AutomationProperties.Name="Instalaciones de Unity detectadas">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#222b38" BorderThickness="0,0,0,1" Padding="16,12">
                        <DockPanel>
                          <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Border.Style>
                              <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                <Setter Property="Margin" Value="12,0,0,0"/>
                              </Style>
                            </Border.Style>
                            <TextBlock>
                              <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                                  <Setter Property="Text" Value="Detectada"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                                      <Setter Property="Text" Value="Agregada a mano"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                          <Border Width="34" Height="34" CornerRadius="10" Background="#142540" Margin="0,0,12,0">
                            <Path Data="{StaticResource IcoCube}" Style="{StaticResource Ico}" Stroke="#79b0ff"/>
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" FontSize="13.5"/>
                            <TextBlock Text="{Binding EditorPath}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding EditorPath}"/>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No se detectaron instalaciones. Agregá Unity.exe a mano." Foreground="#8a96a8" Margin="16,14">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Installs.Count}" Value="0">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <WrapPanel Margin="16,14">
                  <Button Style="{StaticResource Btn}" Command="{Binding RefreshSourcesCommand}" Margin="0,0,10,0">
                    <TextBlock Text="Detectar instalaciones" Foreground="#e7ecf3"/>
                  </Button>
                  <Button Style="{StaticResource BtnSoft}" Click="AddUnity">
                    <StackPanel Orientation="Horizontal">
                      <Path Data="{StaticResource IcoPlus}" Style="{StaticResource Ico}" Margin="0,0,6,0"/>
                      <TextBlock Text="Agregar Unity.exe" Foreground="#79b0ff" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Presets y respaldos -->
          <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource MatchVis}, ConverterParameter=data}">
            <TextBlock Text="Presets y respaldos" Style="{StaticResource SectionHead}"/>
            <TextBlock Text="Tus presets se guardan en este equipo, separados de VCC y de la aplicación original." Style="{StaticResource Lead}"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <StackPanel Margin="16,14">
                  <TextBlock Text="Carpeta de datos" Style="{StaticResource FieldLabel}"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="OpenDataFolder" Margin="8,0,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IcoFolder}" Style="{StaticResource Ico}" Margin="0,0,7,0"/>
                        <TextBlock Text="Abrir carpeta" Foreground="#e7ecf3" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Border Background="#0f151e" BorderBrush="#2c384a" BorderThickness="1" CornerRadius="10" Padding="10,0" Height="34">
                      <TextBlock Text="{Binding DataRoot}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="#a3aebf" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataRoot}"/>
                    </Border>
                  </DockPanel>
                </StackPanel>
                <Border Style="{StaticResource GroupRow}">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                      <Button Style="{StaticResource Btn}" Click="ImportPresets" Margin="0,0,8,0">
                        <TextBlock Text="Importar presets" Foreground="#e7ecf3"/>
                      </Button>
                      <Button Style="{StaticResource Btn}" Click="BackupPresets">
                        <TextBlock Text="Exportar respaldo" Foreground="#e7ecf3"/>
                      </Button>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Importar y respaldar" Style="{StaticResource RowTitle}"/>
                      <TextBlock Text="Importar combina por ID sin duplicar. Después revisá las rutas de Unity y de los archivos." Style="{StaticResource RowHint}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource GroupRow}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="EnableProjectImports" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Elegir proyecto…" Foreground="#e7ecf3"/>
                    </Button>
                    <StackPanel>
                      <TextBlock Text="Activar importación en proyecto existente" Style="{StaticResource RowTitle}"/>
                      <TextBlock Text="Prepara el importador de .unitypackage en un proyecto que ya creaste. Conserva el registro de importaciones completadas." Style="{StaticResource RowHint}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Preferencias -->
          <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource MatchVis}, ConverterParameter=prefs}">
            <TextBlock Text="Preferencias" Style="{StaticResource SectionHead}"/>
            <TextBlock Text="Se aplican al guardar la configuración." Style="{StaticResource Lead}"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <DockPanel Margin="16,14">
                  <ComboBox DockPanel.Dock="Right" Width="180" ItemsSource="{Binding ThemeOptions}" SelectedIndex="0" AutomationProperties.Name="Tema de la aplicación"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tema" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Esta edición incluye solo el tema oscuro." Style="{StaticResource RowHint}"/>
                  </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource GroupRow}">
                  <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="180" ItemsSource="{Binding LanguageOptions}" SelectedIndex="0" AutomationProperties.Name="Idioma"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Idioma" Style="{StaticResource RowTitle}"/>
                      <TextBlock Text="Esta edición está en español." Style="{StaticResource RowHint}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource GroupRow}">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowPrerelease}" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Mostrar versiones preliminares en el editor"/>
                    <StackPanel>
                      <TextBlock Text="Mostrar versiones preliminares en el editor" Style="{StaticResource RowTitle}"/>
                      <TextBlock Text="Incluye betas y candidatas en el selector de versión de cada paquete." Style="{StaticResource RowHint}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
            <TextBlock Text="MochiSprout · aplicación de escritorio para VRChat Creator Companion" Foreground="#8a96a8" FontSize="12.5" Margin="2,16,0,0"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,12,16,12" MinHeight="64">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Btn}" Command="{Binding ResetSettingsCommand}" Margin="0,0,10,0">
            <TextBlock Text="Restablecer cambios" Foreground="#e7ecf3"/>
          </Button>
          <Button Content="Guardar configuración" Style="{StaticResource BtnPrimary}" Command="{Binding SaveSettingsCommand}"/>
        </StackPanel>
        <ProgressBar DockPanel.Dock="Left" Width="60" Height="4" IsIndeterminate="True" Foreground="#79b0ff" Background="#222b38" BorderThickness="0" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource Bool}}"/>
        <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>

<UserControl x:Class="MochiSprout.Views.SetupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" FontFamily="{StaticResource UiFont}" Background="#0d131b">
  <UserControl.Resources>
    <Style x:Key="StepTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#e7ecf3"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="StepText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#a3aebf"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="#10161f"/>
      <Setter Property="BorderBrush" Value="#222b38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Stat" TargetType="Border" BasedOn="{StaticResource Tile}">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="34" Height="20" CornerRadius="10" Background="#2c384a" BorderBrush="Transparent" BorderThickness="1">
              <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#cfd8e4" HorizontalAlignment="Left" Margin="2,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#1f6fe5"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="#79b0ff"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StepButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="10" Padding="8,10" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#142540"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#2c384a"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#79b0ff"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Spinner" TargetType="Ellipse">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="StrokeThickness" Value="2.2"/>
      <Setter Property="StrokeDashArray" Value="7 3"/>
      <Setter Property="Stroke" Value="#79b0ff"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform">
        <Setter.Value>
          <RotateTransform/>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsVisible" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard x:Name="Spin">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <StopStoryboard BeginStoryboardName="Spin"/>
          </Trigger.ExitActions>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24,32">
      <Border x:Name="Card" MaxWidth="1080" MinHeight="600" VerticalAlignment="Center" Background="#151c26" BorderBrush="#263142" BorderThickness="1" CornerRadius="18">
        <Border.Effect>
          <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="60" ShadowDepth="20" Direction="270"/>
        </Border.Effect>
        <Grid x:Name="CardGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="260"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Pasos -->
          <Border x:Name="Rail" Background="#10161f" BorderBrush="#222b38" BorderThickness="0,0,1,0" CornerRadius="17,0,0,17" Padding="16,24">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="8,0,8,16">
                <TextBlock Text="PRIMER INICIO" FontSize="11.5" FontWeight="Bold" Foreground="#8a96a8"/>
                <TextBlock Text="{Binding SetupProgressLabel}" FontSize="13" Foreground="#a3aebf" Margin="0,2,0,0"/>
                <Border Height="4" CornerRadius="2" Background="#222b38" Margin="0,10,0,0" ClipToBounds="True">
                  <Border CornerRadius="2" Background="#79b0ff" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                      <ScaleTransform ScaleX="{Binding SetupProgress}"/>
                    </Border.RenderTransform>
                  </Border>
                </Border>
              </StackPanel>
              <TextBlock DockPanel.Dock="Bottom" Text="Podés volver a abrir esta guía cuando quieras desde Configuración." FontSize="12" Foreground="#8a96a8" TextWrapping="Wrap" Margin="8,16,8,0"/>
              <ItemsControl x:Name="StepList" ItemsSource="{Binding SetupStepItems}" Focusable="False" AutomationProperties.Name="Pasos de la configuración">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource StepButton}" Margin="0,0,0,4" Command="{Binding DataContext.SetupGoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Index}" AutomationProperties.Name="{Binding Label}">
                      <DockPanel>
                        <Border x:Name="Dot" Width="26" Height="26" CornerRadius="13" BorderThickness="1.5" BorderBrush="#2c384a" Margin="0,0,12,0" VerticalAlignment="Center">
                          <Grid>
                            <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="12" FontWeight="Bold" Foreground="#8a96a8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path x:Name="Tick" Data="{StaticResource IcoCheck}" Style="{StaticResource Ico}" Stroke="#5fd39a" StrokeThickness="2.4" Width="11" Height="11" Visibility="Collapsed" HorizontalAlignment="Center"/>
                          </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="13.5" FontWeight="SemiBold" Foreground="#a3aebf" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </DockPanel>
                    </Button>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Dot" Property="Background" Value="#1f6fe5"/>
                        <Setter TargetName="Dot" Property="BorderBrush" Value="#1f6fe5"/>
                        <Setter TargetName="Number" Property="Foreground" Value="White"/>
                        <Setter TargetName="Label" Property="Foreground" Value="#e7ecf3"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsDone}" Value="True">
                        <Setter TargetName="Dot" Property="Background" Value="#10291f"/>
                        <Setter TargetName="Dot" Property="BorderBrush" Value="#1e4a37"/>
                        <Setter TargetName="Number" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Label" Property="Foreground" Value="#c6cfdb"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>

          <!-- Contenido -->
          <DockPanel x:Name="StepContent" Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Margin="32,28,32,0">
              <TextBlock Text="{Binding SetupCounter}" FontSize="12.5" FontWeight="SemiBold" Foreground="#8a96a8"/>
              <TextBlock Text="{Binding SetupTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" AutomationProperties.HeadingLevel="Level1"/>
              <TextBlock Text="{Binding SetupLead}" Foreground="#a3aebf" MaxWidth="620" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Pie -->
            <Border DockPanel.Dock="Bottom" BorderBrush="#222b38" BorderThickness="0,1,0,0" Padding="32,14,20,14" MinHeight="64">
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="Atrás" Style="{StaticResource Btn}" Margin="0,0,12,0" Command="{Binding SetupBackCommand}" Visibility="{Binding SetupCanBack, Converter={StaticResource Bool}}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding SetupSkipCommand}" Visibility="{Binding SetupShowSkip, Converter={StaticResource Bool}}">
                    <TextBlock Text="Configurar después" Foreground="#a3aebf"/>
                  </Button>
                  <Button Content="Ir a la biblioteca" Style="{StaticResource Btn}" Margin="0,0,10,0" Command="{Binding SetupFinishCommand}" Visibility="{Binding SetupIsLast, Converter={StaticResource Bool}}">
                    <Button.CommandParameter>
                      <sys:Boolean>False</sys:Boolean>
                    </Button.CommandParameter>
                  </Button>
                  <Button x:Name="FinishButton" Content="Crear mi primer preset" Style="{StaticResource BtnPrimary}" Command="{Binding SetupFinishCommand}" Visibility="{Binding SetupIsLast, Converter={StaticResource Bool}}">
                    <Button.CommandParameter>
                      <sys:Boolean>True</sys:Boolean>
                    </Button.CommandParameter>
                  </Button>
                  <Button x:Name="NextButton" Content="{Binding SetupNextLabel}" Command="{Binding SetupNextCommand}" IsEnabled="{Binding SetupScanning, Converter={StaticResource MatchBool}, ConverterParameter=False}" Visibility="{Binding SetupIsLast, Converter={StaticResource MatchVis}, ConverterParameter=False}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SetupNextIsPrimary}" Value="False">
                            <Setter Property="Background" Value="#2e2412"/>
                            <Setter Property="BorderBrush" Value="#4f3b18"/>
                            <Setter Property="Foreground" Value="#f3d29c"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
                <TextBlock Text="{Binding SetupFootNote}" FontSize="12.5" Foreground="#8a96a8" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
              </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid Margin="32,22,32,24">

                <!-- 1 · Bienvenida -->
                <StackPanel Visibility="{Binding SetupStep, Converter={StaticResource MatchVis}, ConverterParameter=0}">
                  <UniformGrid x:Name="WelcomeTiles" Columns="3">
                    <Border Style="{StaticResource Tile}" Margin="0,0,6,0">
                      <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#10291f" HorizontalAlignment="Left">
                          <Path Data="{StaticResource IcoLink}" Style="{StaticResource Ico}" Stroke="#5fd39a" Width="18" Height="18"/>
                        </Border>
                        <TextBlock Text="Encontrar VCC" Style="{StaticResource StepTitle}" Margin="0,10,0,0"/>
                        <TextBlock Text="Leemos tus repositorios registrados y las plantillas oficiales. No cambiamos nada en VCC." Style="{StaticResource StepText}"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="6,0">
                      <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#142540" HorizontalAlignment="Left">
                          <Path Data="{StaticResource IcoCube}" Style="{StaticResource Ico}" Stroke="#79b0ff" Width="18" Height="18"/>
                        </Border>
                        <TextBlock Text="Detectar Unity" Style="{StaticResource StepTitle}" Margin="0,10,0,0"/>
                        <TextBlock Text="Buscamos las versiones que instalaste con Unity Hub. Las que falten las podés agregar a mano." Style="{StaticResource StepText}"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="6,0,0,0">
                      <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#221c3a" HorizontalAlignment="Left">
                          <Path Data="{StaticResource IcoSliders}" Style="{StaticResource Ico}" Stroke="#b9a2ff" Width="18" Height="18"/>
                        </Border>
                        <TextBlock Text="Dejar todo a tu gusto" Style="{StaticResource StepTitle}" Margin="0,10,0,0"/>
                        <TextBlock Text="Traemos presets anteriores si los tenés y elegís cómo se comporta el editor." Style="{StaticResource StepText}"/>
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                  <Border Background="#142540" BorderBrush="#1d3a66" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,14,0,0">
                    <DockPanel>
                      <Path Data="{StaticResource IcoInfo}" Style="{StaticResource Ico}" Stroke="#c4dbff" VerticalAlignment="Top" Margin="0,1,10,0"/>
                      <TextBlock Text="Lleva menos de un minuto. Todo lo que elijas acá se puede cambiar después en Configuración." Foreground="#c4dbff" FontSize="13" TextWrapping="Wrap"/>
                    </DockPanel>
                  </Border>
                </StackPanel>

                <!-- 2 · VCC -->
                <StackPanel Visibility="{Binding SetupStep, Converter={StaticResource MatchVis}, ConverterParameter=1}">
                  <Border Style="{StaticResource Tile}" Padding="18" Margin="0,0,0,14" Visibility="{Binding SetupScanning, Converter={StaticResource Bool}}">
                    <DockPanel>
                      <Ellipse Style="{StaticResource Spinner}" Margin="0,0,14,0"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Buscando VRChat Creator Companion…" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="{Binding SetupVccPath}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <StackPanel Visibility="{Binding SetupShowVccFound, Converter={StaticResource Bool}}">
                    <Border Background="#10291f" BorderBrush="#1e4a37" BorderThickness="1" CornerRadius="14" Padding="18,16">
                      <DockPanel>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#0b2018" Margin="0,0,14,0">
                          <Path Data="{StaticResource IcoCheck}" Style="{StaticResource Ico}" Stroke="#5fd39a" StrokeThickness="2.2" Width="18" Height="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding SetupVccHeadline}" Style="{StaticResource StepTitle}" Foreground="#bdebd3"/>
                          <TextBlock Text="Se encontró settings.json. Es una lectura de archivos: no hace falta que VCC esté abierto." FontSize="12.5" Foreground="#8fcfae" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <UniformGrid Columns="3" Margin="0,14,0,0">
                      <Border Style="{StaticResource Stat}" Margin="0,0,6,0">
                        <StackPanel>
                          <TextBlock Text="{Binding SetupRepoCount}" FontSize="22" FontWeight="SemiBold"/>
                          <TextBlock Text="repositorios registrados" FontSize="12.5" Foreground="#8a96a8"/>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource Stat}" Margin="6,0">
                        <StackPanel>
                          <TextBlock Text="{Binding SetupPackageCount}" FontSize="22" FontWeight="SemiBold"/>
                          <TextBlock Text="paquetes en la caché local" FontSize="12.5" Foreground="#8a96a8"/>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource Stat}" Margin="6,0,0,0">
                        <StackPanel>
                          <TextBlock Text="{Binding SetupTemplateCount}" FontSize="22" FontWeight="SemiBold"/>
                          <TextBlock Text="plantillas oficiales" FontSize="12.5" Foreground="#8a96a8"/>
                        </StackPanel>
                      </Border>
                    </UniformGrid>
                  </StackPanel>
                  <Border Background="#2e2412" BorderBrush="#4f3b18" BorderThickness="1" CornerRadius="14" Padding="18,16" Visibility="{Binding SetupShowVccMissing, Converter={StaticResource Bool}}">
                    <DockPanel>
                      <Border Width="36" Height="36" CornerRadius="10" Background="#241b0c" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Path Data="{StaticResource IcoAlert}" Style="{StaticResource Ico}" Stroke="#f0b35a" Width="18" Height="18"/>
                      </Border>
                      <StackPanel>
                        <TextBlock Text="No encontramos VCC en esa carpeta" Style="{StaticResource StepTitle}" Foreground="#f3d29c"/>
                        <TextBlock FontSize="13" Foreground="#e3c48f" TextWrapping="Wrap" Margin="0,3,0,0"><Run Text="Si lo instalaste en otro lado, elegí la carpeta que tiene settings.json. Si todavía no lo tenés, descargalo desde "/><Hyperlink NavigateUri="https://vcc.docs.vrchat.com/" RequestNavigate="OpenLink" Foreground="#79b0ff">vcc.docs.vrchat.com</Hyperlink><Run Text=" y volvé a buscar."/></TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <StackPanel Margin="0,14,0,0" Visibility="{Binding SetupScanning, Converter={StaticResource MatchVis}, ConverterParameter=False}">
                    <TextBlock Text="Carpeta de datos de VCC" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="Elegir carpeta…" Style="{StaticResource Btn}" Click="PickVcc" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource BtnGhost}" Command="{Binding SetupRescanCommand}">
                          <TextBlock Text="Volver a buscar" Foreground="#a3aebf"/>
                        </Button>
                      </StackPanel>
                      <Border Background="#0f151e" BorderBrush="#2c384a" BorderThickness="1" CornerRadius="10" Height="36" Padding="11,0">
                        <TextBlock Text="{Binding SetupVccPath}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="#e7ecf3" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SetupVccPath}" AutomationProperties.Name="Carpeta de datos de VCC"/>
                      </Border>
                    </DockPanel>
                  </StackPanel>
                </StackPanel>

                <!-- 3 · Unity -->
                <StackPanel Visibility="{Binding SetupStep, Converter={StaticResource MatchVis}, ConverterParameter=2}">
                  <Border Style="{StaticResource Tile}" Padding="18" Visibility="{Binding SetupScanning, Converter={StaticResource Bool}}">
                    <DockPanel>
                      <Ellipse Style="{StaticResource Spinner}" Margin="0,0,14,0"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Buscando instalaciones de Unity…" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="Unity Hub, Program Files y las que agregaste antes" FontSize="12.5" Foreground="#8a96a8"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <StackPanel Visibility="{Binding SetupScanning, Converter={StaticResource MatchVis}, ConverterParameter=False}">
                    <Border BorderBrush="#222b38" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding SetupUnity}" Focusable="False" AutomationProperties.Name="Instalaciones de Unity">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border x:Name="Row" Background="#151c26" BorderBrush="#222b38" BorderThickness="0,0,0,1" Padding="16,12">
                                <DockPanel>
                                  <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="{Binding Version, StringFormat=Usar Unity {0}}"/>
                                  <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="#142540" Margin="8,0,14,0">
                                    <Path Data="{StaticResource IcoCube}" Style="{StaticResource Ico}" Stroke="#79b0ff"/>
                                  </Border>
                                  <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource ChipText}"/>
                                  </Border>
                                  <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Version}" FontFamily="{StaticResource MonoFont}" FontSize="13.5"/>
                                    <TextBlock Text="{Binding EditorPath}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#8a96a8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding EditorPath}"/>
                                  </StackPanel>
                                </DockPanel>
                              </Border>
                              <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                  <Setter TargetName="Row" Property="Background" Value="#10161f"/>
                                  <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No encontramos Unity en esta computadora. Instalalo con Unity Hub o agregá Unity.exe a mano." Foreground="#a3aebf" TextWrapping="Wrap" Margin="16,14">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SetupUnity.Count}" Value="0">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Background="#10161f">
                          <Button Style="{StaticResource BtnSoft}" Click="AddUnity" Margin="16,12,8,12">
                            <StackPanel Orientation="Horizontal">
                              <Path Data="{StaticResource IcoPlus}" Style="{StaticResource Ico}" Margin="0,0,7,0"/>
                              <TextBlock Text="Agregar Unity.exe…" Foreground="#79b0ff" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <Button Style="{StaticResource BtnGhost}" Command="{Binding SetupRescanCommand}" Margin="0,12">
                            <TextBlock Text="Volver a buscar" Foreground="#a3aebf"/>
                          </Button>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <UniformGrid Columns="2" Margin="0,14,0,0">
                      <Border CornerRadius="12" Padding="16,14" BorderThickness="1" Margin="0,0,6,0">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#10291f"/>
                            <Setter Property="BorderBrush" Value="#1e4a37"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding SetupHas2022}" Value="False">
                                <Setter Property="Background" Value="#2e2412"/>
                                <Setter Property="BorderBrush" Value="#4f3b18"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <StackPanel>
                          <TextBlock Text="Presets con Unity 2022" Style="{StaticResource StepTitle}"/>
                          <TextBlock Text="{Binding Setup2022Text}" FontSize="12.5" Foreground="#c6cfdb" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                      <Border CornerRadius="12" Padding="16,14" BorderThickness="1" Margin="6,0,0,0">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#10291f"/>
                            <Setter Property="BorderBrush" Value="#1e4a37"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding SetupHas2019}" Value="False">
                                <Setter Property="Background" Value="#2e2412"/>
                                <Setter Property="BorderBrush" Value="#4f3b18"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <StackPanel>
                          <TextBlock Text="Presets con Unity 2019" Style="{StaticResource StepTitle}"/>
                          <TextBlock Text="{Binding Setup2019Text}" FontSize="12.5" Foreground="#c6cfdb" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </UniformGrid>
                  </StackPanel>
                </StackPanel>

                <!-- 4 · Tus datos -->
                <StackPanel Visibility="{Binding SetupStep, Converter={StaticResource MatchVis}, ConverterParameter=3}">
                  <Border Style="{StaticResource Tile}" Padding="18,16" Margin="0,0,0,14" Visibility="{Binding SetupHasLegacy, Converter={StaticResource Bool}}">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Left" IsChecked="{Binding SetupImportLegacy}" VerticalAlignment="Top" Margin="0,2,14,0" AutomationProperties.Name="Traer mis presets de VCC Preset Studio"/>
                      <StackPanel>
                        <TextBlock Text="Traer mis presets de VCC Preset Studio" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="{Binding SetupLegacyText}" Style="{StaticResource StepText}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <TextBlock Text="Dónde se guardan tus presets" Style="{StaticResource FieldLabel}"/>
                  <Border Background="#0f151e" BorderBrush="#2c384a" BorderThickness="1" CornerRadius="10" Height="36" Padding="11,0">
                    <TextBlock Text="{Binding DataRoot}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="#a3aebf" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataRoot}"/>
                  </Border>
                  <TextBlock Text="Quedan en esta computadora, separados de VCC y de tus proyectos de Unity." Style="{StaticResource Hint}" Margin="0,6,0,14"/>
                  <Border Style="{StaticResource Tile}" Padding="16,14">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Importar respaldo .json…" Style="{StaticResource Btn}" Click="ImportBackup" VerticalAlignment="Center" Margin="12,0,0,0"/>
                      <StackPanel>
                        <TextBlock Text="¿Tenés un respaldo de otra PC?" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="{Binding SetupBackupText}" Style="{StaticResource StepText}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </StackPanel>

                <!-- 5 · Preferencias -->
                <Border Visibility="{Binding SetupStep, Converter={StaticResource MatchVis}, ConverterParameter=4}" Background="#10161f" BorderBrush="#222b38" BorderThickness="1" CornerRadius="14" VerticalAlignment="Top">
                  <StackPanel>
                    <DockPanel Margin="16,14">
                      <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SetupPrerelease}" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Mostrar versiones preliminares"/>
                      <StackPanel>
                        <TextBlock Text="Mostrar versiones preliminares" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="Incluye betas y candidatas en el selector de versión de cada paquete." Style="{StaticResource StepText}"/>
                      </StackPanel>
                    </DockPanel>
                    <Border BorderBrush="#222b38" BorderThickness="0,1,0,0" Padding="16,14">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Width="160" Height="34" CornerRadius="10" Background="#0f151e" BorderBrush="#2c384a" BorderThickness="1" Padding="12,0">
                          <TextBlock Text="Oscuro" Foreground="#a3aebf" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                          <TextBlock Text="Tema" Style="{StaticResource StepTitle}"/>
                          <TextBlock Text="Esta edición incluye solo el tema oscuro." Style="{StaticResource StepText}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <Border BorderBrush="#222b38" BorderThickness="0,1,0,0" Padding="16,14">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Width="160" Height="34" CornerRadius="10" Background="#0f151e" BorderBrush="#2c384a" BorderThickness="1" Padding="12,0">
                          <TextBlock Text="Español" Foreground="#a3aebf" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                          <TextBlock Text="Idioma" Style="{StaticResource StepTitle}"/>
                          <TextBlock Text="Esta edición está en español." Style="{StaticResource StepText}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- 6 · Listo -->
                <StackPanel Visibility="{Binding SetupStep, Converter={StaticResource MatchVis}, ConverterParameter=5}">
                  <Border BorderBrush="#222b38" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding SetupSummary}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#10161f" BorderBrush="#222b38" BorderThickness="0,0,0,1" Padding="16,13">
                            <DockPanel>
                              <Border x:Name="Icon" DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="#10291f" Margin="0,0,14,0">
                                <Path x:Name="Glyph" Data="{StaticResource IcoCheck}" Style="{StaticResource Ico}" Stroke="#5fd39a" StrokeThickness="2.4" Width="11" Height="11"/>
                              </Border>
                              <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="140" Foreground="#8a96a8" FontSize="13" VerticalAlignment="Center"/>
                              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Height="28" Padding="8,0" Command="{Binding DataContext.SetupGoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Step}" AutomationProperties.Name="{Binding Label, StringFormat=Cambiar {0}}">
                                <TextBlock Text="Cambiar" Foreground="#79b0ff" FontSize="12.5"/>
                              </Button>
                              <TextBlock Text="{Binding Value}" FontSize="13.5" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                            </DockPanel>
                          </Border>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Ok}" Value="False">
                              <Setter TargetName="Icon" Property="Background" Value="#2e2412"/>
                              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource IcoAlert}"/>
                              <Setter TargetName="Glyph" Property="Stroke" Value="#f0b35a"/>
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <Border Background="#13302b" BorderBrush="#1f4a40" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,14,0,0">
                    <DockPanel>
                      <Path Data="{StaticResource IcoSprout}" Style="{StaticResource Ico}" Stroke="#7fd6b8" VerticalAlignment="Top" Margin="0,1,10,0"/>
                      <TextBlock Text="Todo listo. Creá tu primer preset o, si preferís, partí de una plantilla oficial de VCC." Foreground="#bdebd3" FontSize="13" TextWrapping="Wrap"/>
                    </DockPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>

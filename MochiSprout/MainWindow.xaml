<Window x:Class="MochiSprout.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MochiSprout.Views" Title="MochiSprout" Width="1440" Height="940" MinWidth="760" MinHeight="750" FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource Ink}" Background="#0d131b" WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Foreground" Value="#8a96a8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#1a2230"/>
                <Setter Property="Foreground" Value="#e7ecf3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseCaptionBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#c42b1c"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="WindowRoot">
    <Grid x:Name="RootGrid" Background="#0d131b">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
      </Grid.RowDefinitions>

      <!-- Barra de título integrada -->
      <Border Background="{StaticResource Chrome}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Margin="14,0,12,0" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource SproutBg}">
              <Path Data="{StaticResource IcoSprout}" Style="{StaticResource Ico}" Stroke="{StaticResource SproutInk}" Width="17" Height="17"/>
            </Border>
            <TextBlock Text="MochiSprout" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="BrandSubtitle" Text="Tu próximo proyecto, listo." Foreground="#8a96a8" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
            <Border Style="{StaticResource Chip}" Background="#13302b" BorderBrush="#1f4a40" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSetup, Converter={StaticResource Bool}}">
              <TextBlock Text="Configuración inicial" Style="{StaticResource ChipText}" Foreground="#7fd6b8"/>
            </Border>
          </StackPanel>
          <Border x:Name="SearchBox" Grid.Column="1" MaxWidth="440" Height="30" Margin="12,0" CornerRadius="9" Background="{StaticResource Surface2}" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid Margin="10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Path Data="{StaticResource IcoSearch}" Style="{StaticResource Ico}" Stroke="#8a96a8" Width="14" Height="14"/>
              <TextBox x:Name="PresetSearchInput" Grid.Column="1" Text="{Binding PresetSearch, UpdateSourceTrigger=PropertyChanged, Delay=180}" Tag="Buscar presets por nombre o paquete" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="8,0" FontSize="13" VerticalContentAlignment="Center" AutomationProperties.Name="Buscar presets">
                <TextBox.Template>
                  <ControlTemplate TargetType="TextBox">
                    <Grid>
                      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                      <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#8a96a8" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="Text" Value="">
                        <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </TextBox.Template>
              </TextBox>
              <Border Grid.Column="2" BorderBrush="{StaticResource LineStrong}" BorderThickness="1,1,1,2" CornerRadius="5" Padding="5,0" VerticalAlignment="Center">
                <TextBlock Text="Ctrl K" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#8a96a8"/>
              </Border>
            </Grid>
          </Border>
          <StackPanel x:Name="TitleActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource BtnSm}" Background="Transparent" BorderBrush="Transparent" Foreground="#a3aebf" Command="{Binding NavigateCommand}" CommandParameter="Paquetes de VCC" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,4,0" ToolTip="Catálogo de paquetes de VCC">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IcoBox}" Style="{StaticResource Ico}" Margin="0,0,7,0"/>
                <TextBlock Text="Paquetes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource IconBtnSm}" Command="{Binding OpenSettingsCommand}" CommandParameter="vcc" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Configuración" ToolTip="Configuración">
              <Path Data="{StaticResource IcoGear}" Style="{StaticResource Ico}"/>
            </Button>
          </StackPanel>
          <StackPanel x:Name="CaptionButtons" Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
            <Button Style="{StaticResource CaptionBtn}" Click="MinimizeWindow" AutomationProperties.Name="Minimizar" ToolTip="Minimizar">
              <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="1"/>
            </Button>
            <Button Style="{StaticResource CaptionBtn}" Click="ToggleMaximize" AutomationProperties.Name="Maximizar o restaurar" ToolTip="Maximizar">
              <Rectangle x:Name="MaximizeGlyph" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" RadiusX="1" RadiusY="1"/>
            </Button>
            <Button Style="{StaticResource CloseCaptionBtn}" Click="CloseWindow" AutomationProperties.Name="Cerrar" ToolTip="Cerrar">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <views:PresetsView x:Name="Library" Grid.Row="1">
        <views:PresetsView.Style>
          <Style TargetType="views:PresetsView">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="IsEnabled" Value="False"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </views:PresetsView.Style>
      </views:PresetsView>

      <!-- Barra de estado -->
      <Border Grid.Row="2" Background="{StaticResource Chrome}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="14,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border VerticalAlignment="Center" Height="18" Margin="0,0,14,0">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource ChipOk}">
                <Setter Property="Margin" Value="0,0,14,0"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding VccConnected}" Value="False">
                    <Setter Property="Background" Value="#2e2412"/>
                    <Setter Property="BorderBrush" Value="#4f3b18"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#5fd39a"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding VccConnected}" Value="False">
                        <Setter Property="Fill" Value="#f0b35a"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding VccEnvTitle}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#5fd39a"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding VccConnected}" Value="False">
                        <Setter Property="Foreground" Value="#f0b35a"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#8a96a8" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
          <ProgressBar Grid.Column="2" Width="140" Height="4" Margin="14,0" IsIndeterminate="True" Foreground="#79b0ff" Background="#222b38" BorderThickness="0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Bool}}"/>
          <TextBlock Grid.Column="3" Text="{Binding PresetCount}" Foreground="#8a96a8" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Overlays dentro del área cliente (debajo de la barra de título) -->
      <Grid x:Name="EditorOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#B305080C" Visibility="{Binding IsEditor, Converter={StaticResource Bool}}">
        <Border x:Name="EditorPanel" Width="1080" Height="744" Style="{StaticResource ModalPanel}" FocusManager.IsFocusScope="True">
          <views:EditorView x:Name="PresetEditor">
            <views:EditorView.Style>
              <Style TargetType="views:EditorView">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </views:EditorView.Style>
          </views:EditorView>
        </Border>
      </Grid>
      <Grid x:Name="PackagesOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#B305080C" Visibility="Collapsed">
        <Border x:Name="PackagesPanel" Width="1080" Height="744" Style="{StaticResource ModalPanel}" FocusManager.IsFocusScope="True">
          <views:CatalogView/>
        </Border>
      </Grid>
      <!-- Asistente de primer inicio: ocupa el área de contenido, debajo de la barra de título -->
      <Grid x:Name="SetupOverlay" Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding IsSetup, Converter={StaticResource Bool}}">
        <views:SetupView x:Name="Setup">
          <views:SetupView.Style>
            <Style TargetType="views:SetupView">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:SetupView.Style>
        </views:SetupView>
      </Grid>
      <Grid Grid.Row="1" Grid.RowSpan="2" Background="#B305080C" Visibility="{Binding TemplateDetailsOpen, Converter={StaticResource Bool}}">
        <Border Style="{StaticResource ModalPanel}" Width="700" MaxHeight="650" Margin="20">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="20,12,12,12">
              <Grid>
                <StackPanel Margin="0,0,48,0">
                  <TextBlock Text="{Binding TemplateDetailsTitle}" Style="{StaticResource ModalTitle}"/>
                  <TextBlock Text="Paquetes de la plantilla · solo lectura" Style="{StaticResource ModalSubtitle}"/>
                </StackPanel>
                <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" Command="{Binding CloseTemplateDetailsCommand}" AutomationProperties.Name="Cerrar" ToolTip="Cerrar">
                  <Path Data="{StaticResource IcoX}" Style="{StaticResource Ico}" Width="14" Height="14"/>
                </Button>
              </Grid>
            </Border>
            <ListBox ItemsSource="{Binding TemplateDetails}" Background="{StaticResource Surface2}" AutomationProperties.Name="Paquetes de la plantilla">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="20,12" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1" Text="{Binding Version}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="#79b0ff"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
